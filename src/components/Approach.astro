---
import { approach } from '../data/site';
---

<section class="approach wrap" aria-labelledby="approach-h">
  <h2 class="h1" id="approach-h">How I work</h2>
  <p class="body approach-intro">Each rule I work by comes back to the sales team.</p>
  <ul class="rules">
    {
      approach.map((a) => (
        <li>
          <h3 class="rule-t">{a.t}</h3>
          <p class="body">{a.d}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .approach { padding-top: 160px; }
  .approach-intro { margin-top: 24px; }
  .rules { margin-top: 56px; border-bottom: 1px solid var(--line); }
  .rules li { border-top: 1px solid var(--line); padding: 48px 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; }
  .rule-t { grid-column: 1 / 6; font: 520 32px / 1.1 var(--display); letter-spacing: -.02em; text-wrap: balance; }
  .rules .body { grid-column: 7 / 12; font-size: 17px; line-height: 1.55; }
  @media (max-width: 899px) {
    .rules li { grid-template-columns: 1fr; row-gap: 14px; padding: 32px 0; }
    .rule-t, .rules .body { grid-column: 1 / -1; }
    .rule-t { font-size: 26px; }
  }
</style>
