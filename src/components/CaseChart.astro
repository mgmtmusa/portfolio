---
// One chart per case cover on /work/, drawn from site.ts figures only. HTML and CSS: every label is real text
// (no SVG text), and nothing repeats a figure the cover already shows, so no number appears more than twice.
// Evitech: before and after bars for the two results, drawn to scale (0.72 and 1.65 of before), no numbers.
// I Heart Uni: a zero-based slope from 400 to 13,200. The Lil Project: a 48 × 16 grid, exactly 768 dots.
// The caption comes from the default slot.
interface Props { slug: 'evitech' | 'i-heart-uni' | 'the-lil-project' }
const { slug } = Astro.props;

const ev = [
  { name: 'Cost per acquisition', after: 0.72 },
  { name: 'Qualified leads', after: 1.65 },
];
const evMax = Math.max(1, ...ev.map((g) => g.after));
const pct = (v: number) => `${((v / evMax) * 100).toFixed(2)}%`;

const start = 400, current = 13200;
const startPct = ((start / current) * 100).toFixed(2);
---

<figure class={`chart chart--${slug}`} data-chart={slug}>
  {
    slug === 'evitech' && (
      <div class="ev" aria-hidden="true">
        <div class="ev-plot">
          {ev.map((g) => (
            <div class="ev-g">
              <div class="ev-bars">
                <span class="ev-bar ev-bar--before" style={`--h: ${pct(1)}`} data-ratio="1" />
                <span class="ev-bar ev-bar--after" style={`--h: ${pct(g.after)}`} data-ratio={g.after} />
              </div>
              <p class="ev-n">{g.name}</p>
            </div>
          ))}
        </div>
        <p class="ev-key">
          <span class="ev-key-i"><span class="ev-sw ev-sw--before" />Before</span>
          <span class="ev-key-i"><span class="ev-sw ev-sw--after" />After</span>
        </p>
      </div>
    )
  }
  {
    slug === 'i-heart-uni' && (
      <div class="ihu" style={`--start: ${startPct}%`}>
        <div class="ihu-plot">
          <svg class="ihu-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <line class="ihu-base" x1="0" y1="100" x2="100" y2="100" vector-effect="non-scaling-stroke" />
            <line class="ihu-line" x1="0" y1={100 - Number(startPct)} x2="100" y2="0" vector-effect="non-scaling-stroke" />
          </svg>
          <span class="ihu-dot ihu-dot--a" aria-hidden="true" />
          <span class="ihu-dot ihu-dot--b" aria-hidden="true" />
        </div>
        <p class="ihu-v ihu-v--a"><span class="ihu-k">Start</span> <span class="ihu-n">400</span></p>
        <p class="ihu-v ihu-v--b"><span class="ihu-k">Current</span> <span class="ihu-n">13,200</span></p>
      </div>
    )
  }
  {slug === 'the-lil-project' && <div class="lil" aria-hidden="true" data-cols="48" data-rows="16" />}
  {Astro.slots.has('default') && <figcaption class="chart-cap"><slot />{slug === 'evitech' && ' Bars are drawn to scale from the two percentages.'}</figcaption>}
</figure>

<style>
  .chart { margin: 0; display: grid; gap: 16px; }
  .chart-cap { font: 400 13px / 18px var(--ui); color: var(--text-2); max-width: min(46ch, 330px); }

  /* Evitech: paired bars on one baseline. Before is a quiet fill, after is the text colour. */
  .ev { display: grid; gap: 14px; }
  .ev-plot { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  .ev-bars { display: flex; align-items: flex-end; gap: 6px; height: 132px; border-bottom: 1px solid var(--line-strong); }
  .ev-bar { width: 44px; height: var(--h); border-radius: 6px 6px 0 0; }
  .ev-bar--before { background: rgb(243 238 228 / .16); }
  .ev-bar--after { background: var(--text); }
  .ev-n { margin-top: 10px; font: 400 13px / 18px var(--ui); color: var(--text-2); }
  .ev-key { display: flex; gap: 20px; font: 500 11px / 1.4 var(--mono); letter-spacing: .08em; color: var(--text-3); }
  .ev-key-i { display: inline-flex; align-items: center; gap: 8px; }
  .ev-sw { width: 10px; height: 10px; border-radius: 2px; }
  .ev-sw--before { background: rgb(243 238 228 / .16); }
  .ev-sw--after { background: var(--text); }

  /* I Heart Uni: zero-based, so the start sits just above the baseline. */
  .ihu { position: relative; display: grid; grid-template-columns: 1fr auto; grid-template-rows: auto 132px auto; column-gap: 16px; }
  .ihu-plot { position: relative; grid-column: 1 / -1; grid-row: 2; }
  .ihu-svg { width: 100%; height: 100%; overflow: visible; }
  .ihu-base { stroke: var(--line-strong); stroke-width: 1; }
  .ihu-line { stroke: var(--text); stroke-width: 2; stroke-linecap: round; }
  .ihu-dot { position: absolute; width: 9px; height: 9px; border-radius: 50%; background: var(--text); transform: translate(-50%, 50%); }
  .ihu-dot--a { left: 0; bottom: var(--start); }
  .ihu-dot--b { left: 100%; bottom: 100%; }
  .ihu-v { display: flex; align-items: baseline; gap: 8px; }
  .ihu-v--a { grid-column: 1; grid-row: 3; margin-top: 10px; }
  .ihu-v--b { grid-column: 2; grid-row: 1; margin-bottom: 12px; justify-self: end; }
  .ihu-k { font: 500 11px / 1.4 var(--mono); letter-spacing: .08em; color: var(--text-3); }
  .ihu-n { font: 500 15px / 1 var(--ui); color: var(--text); font-variant-numeric: tabular-nums; }

  /* The Lil Project: one tile per child, 48 across and 16 down (768). Square tiles, so the box is 3:1. */
  .lil {
    aspect-ratio: 48 / 16; width: 100%; max-width: 560px;
    background-image: radial-gradient(circle closest-side, rgb(243 241 236 / .82) 0 52%, transparent 60%);
    background-size: calc(100% / 48) calc(100% / 16);
    background-repeat: repeat;
  }

  @media (forced-colors: active) {
    .ev-bar--after, .ev-sw--after, .ihu-dot { background: CanvasText; forced-color-adjust: none; }
    .ev-bar--before, .ev-sw--before { background: GrayText; forced-color-adjust: none; }
    .ihu-line { stroke: CanvasText; }
    .lil { forced-color-adjust: none; background-image: radial-gradient(circle closest-side, CanvasText 0 52%, transparent 60%); }
  }
</style>
