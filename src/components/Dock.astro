---
// The floating glass dock: bottom centre on every screen (creative director, phase 2).
// On phones it holds Menu and Get in touch; without JavaScript the page links show instead of Menu.
// On /contact/ it keeps clear of the brief (finish r3 1, creative director r3 3): out at rest and, on phones, while
// focus is inside the form.
---

<div class="dock glass xfade" transition:persist="dock" data-dock>
  <nav class="dock-nav" aria-label="Main">
    <a class="dock-link" href="/work/">Work</a>
    <a class="dock-link" href="/about/">About</a>
    <a class="dock-link" href="/contact/">Contact</a>
    <button class="dock-menu js-only" type="button" data-cmdk-open aria-haspopup="dialog" aria-controls="cmdk">
      Menu<span class="sr"> (Command K)</span><kbd class="dock-k" aria-hidden="true">⌘K</kbd>
    </button>
  </nav>
  <div class="dock-cta-wrap"><div class="dock-cta-clip"><a class="cta dock-cta" href="/contact/" data-track="contact_click" data-from="dock">Get in touch</a></div></div>
</div>

<style>
  .dock {
    --rim: .35; --glass-blur: 16px;
    position: fixed; z-index: 50; left: 50%; bottom: 24px; transform: translateX(-50%);
    height: 56px; border-radius: 28px; padding: 0 8px 0 10px;
    display: flex; align-items: center; gap: 4px;
    background: rgb(26 24 22 / .62);
    font: 500 14px / 1 var(--ui); white-space: nowrap;
    transition: opacity var(--dur-ui) ease-out, visibility 0s;
  }
  :global(html.js[data-page='home']) .dock:not([data-shown]) { opacity: 0; pointer-events: none; }
  /* Contact: hidden (and out of the tab order) until the script says the form is clear of it. */
  :global(html.js[data-route='contact']) .dock:not([data-up]) {
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity var(--dur-ui) ease-out, visibility 0s var(--dur-ui);
  }
  .dock-nav { display: flex; align-items: center; gap: 4px; }
  .dock-link, .dock-menu {
    display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 12px; border-radius: 22px;
    color: var(--text); text-decoration: none; background: none; border: 0; cursor: pointer; font: inherit;
    transition: background-color var(--dur-fast) ease-out;
  }
  .dock-link[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 6px; }
  @media (hover: hover) and (pointer: fine) { .dock-link:hover, .dock-menu:hover { background: rgb(255 250 240 / .06); } }
  .dock-k { font: 500 11px / 1 var(--mono); padding: 4px 6px; border-radius: 6px; border: 1px solid var(--line-strong); color: var(--text-2); }
  .dock-cta { height: 40px; padding: 0 18px; border-radius: 20px; }
  /* The CTA folds away (and back) instead of popping, so the dock's width never jumps while it is on screen.
     The clip's padding leaves room for the focus ring. */
  .dock-cta-wrap {
    display: flex;
    transition: opacity var(--dur-fast) ease-out, margin var(--dur-ui) var(--ease-out), visibility 0s;
  }
  .dock-cta-clip {
    max-width: 150px; overflow: hidden; padding: 6px 5px 6px 9px; margin: -6px -5px -6px -5px;
    transition: max-width var(--dur-ui) var(--ease-out), padding var(--dur-ui) var(--ease-out);
  }
  .dock[data-cta-hidden] .dock-cta-wrap,
  :global(html[data-route='contact']) .dock-cta-wrap {
    opacity: 0; visibility: hidden; margin-left: -4px;
    transition: opacity var(--dur-fast) ease-out, margin var(--dur-ui) var(--ease-out), visibility 0s var(--dur-ui);
  }
  .dock[data-cta-hidden] .dock-cta-clip,
  :global(html[data-route='contact']) .dock-cta-clip { max-width: 0; padding-left: 0; padding-right: 0; }
  :global(html:not(.js)) .js-only { display: none !important; }
  @media (max-width: 639px) {
    /* A content-width pill, centred: it never spans the column, so it covers as little of the page as it can. */
    .dock { max-width: calc(100vw - 32px); bottom: calc(12px + env(safe-area-inset-bottom)); }
    :global(html.js) .dock-link { display: none; }
    .dock-k { display: none; }
    :global(html:not(.js)) .dock-link { padding: 0 9px; }
  }
</style>

<script>
  // Contact: the dock stays off the brief. It shows only past 160px of scroll, and on phones (where the pill sits over
  // the field being typed in, above the keyboard) it leaves while focus is inside the form.
  const REST = 160;
  let stop: (() => void) | null = null;
  function arm() {
    stop?.();
    stop = null;
    const dock = document.querySelector<HTMLElement>('[data-dock]');
    const form = document.documentElement.dataset.route === 'contact' ? document.querySelector<HTMLElement>('[data-brief]') : null;
    if (!dock || !form) return;
    const phone = matchMedia('(max-width: 639px)');
    const update = (focus: Element | null = document.activeElement) => {
      const up = scrollY > REST && !(phone.matches && focus && form.contains(focus));
      if (up) dock.dataset.up = ''; else delete dock.dataset.up;
    };
    const onScroll = () => update();
    const onIn = (e: FocusEvent) => update(e.target as Element);
    const onOut = (e: FocusEvent) => update(e.relatedTarget as Element | null);
    update();
    addEventListener('scroll', onScroll, { passive: true });
    phone.addEventListener('change', onScroll);
    form.addEventListener('focusin', onIn);
    form.addEventListener('focusout', onOut);
    stop = () => {
      removeEventListener('scroll', onScroll);
      phone.removeEventListener('change', onScroll);
      form.removeEventListener('focusin', onIn);
      form.removeEventListener('focusout', onOut);
      delete dock.dataset.up;
    };
  }
  document.addEventListener('astro:page-load', arm);
  document.addEventListener('astro:before-swap', () => { stop?.(); stop = null; });
</script>
