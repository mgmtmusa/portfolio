---
import { site } from '../data/site';
// Settled sentences appear verbatim or not at all (principal, G4).
const availability = site.availability;
// Home paints with the hero's own availability on screen, so the strip starts hidden there; the hero script reveals it on scroll.
const onHome = Astro.url.pathname === '/';
---

<div class="strip" transition:persist="strip" data-avail-hidden={onHome ? '' : undefined}>
  <p class="strip-t">Melbourne <time class="strip-clock" data-clock></time></p>
  <p class="strip-c">{availability}</p>
  <p class="strip-r">{site.replyTime.text}</p>
</div>

<style>
  .strip {
    position: fixed; inset: 0 0 auto; z-index: 40; height: 32px;
    display: flex; align-items: center; justify-content: space-between; gap: 32px;
    padding: 0 var(--edge);
    font: 400 var(--fs-label) / 1 var(--mono); letter-spacing: .08em; color: var(--text-2);
    pointer-events: none;
  }
  .strip::before {
    content: ''; position: absolute; inset: 0 0 -32px; z-index: -1; opacity: 0;
    background: linear-gradient(#121110 0, rgb(18 17 16 / .86) 32px, transparent 64px);
    transition: opacity 180ms ease-out;
  }
  .strip[data-scrolled]::before { opacity: 1; }
  .strip p { margin: 0; white-space: nowrap; }
  .strip-clock { color: var(--text); font-variant-numeric: tabular-nums; display: inline-block; min-width: 8ch; }
  .strip-c { transition: opacity var(--dur-ui) ease-out; }
  .strip-r { transition: opacity var(--dur-ui) ease-out; }
  .strip[data-avail-hidden] .strip-c, .strip[data-avail-hidden] .strip-r { opacity: 0; }
  @media (max-width: 1179px) { .strip-c { display: none; } }
  @media (max-width: 639px) { .strip { height: 28px; } .strip-r { display: none; } }
</style>
