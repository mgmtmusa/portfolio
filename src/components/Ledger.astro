---
// The growth-work ledger on /work/: six rows from site.ts growthWork. The figures sit outside <summary>, so they
// always show and the footnote buttons never nest inside the summary's button; <details> opens what was done,
// by click or keyboard, with no JavaScript.
import Footnote from './Footnote.astro';
import type { Result } from '../data/site';
interface Row { t: string; org: string; did: string; results: Result[]; line?: string; note?: { n: number; id: string; note: string } }
interface Props { rows: Row[] }
const { rows } = Astro.props;
---

<ol class="ledger" data-ledger>
  {
    rows.map((r) => (
      <li class="row" data-fact={r.results.map((x) => x.v).join('|')}>
        <div class="row-main">
        <div class="row-figs">
          {r.results.map((x, i) => (
            <p class="row-r">
              <span class="row-v">
                {x.v}
                {i === r.results.length - 1 && r.note && <Footnote {...r.note} />}
              </span>
              <span class="row-l">
                {x.l}
                {x.scope && <span class="row-scope label">{x.scope}</span>}
              </span>
            </p>
          ))}
        </div>
        {r.line && <p class="row-note">{r.line}</p>}
        </div>
        <details class="row-d">
          <summary class="row-s">
            <span class="row-t">{r.t}</span>
            <span class="row-org label">{r.org}</span>
            <span class="row-i" aria-hidden="true" />
          </summary>
          <p class="row-did body">{r.did}</p>
        </details>
      </li>
    ))
  }
</ol>

<style>
  .ledger { border-bottom: 1px solid var(--line); }
  .row {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter);
    padding: 28px 0 30px; border-top: 1px solid var(--line); align-items: start;
  }
  .row-main { grid-column: 1 / 7; display: grid; gap: 14px; min-width: 0; }
  .row-note { font: 400 13px / 18px var(--ui); color: var(--text-3); }
  .row-figs { display: flex; flex-wrap: wrap; gap: 18px 40px; }
  .row-r { display: grid; gap: 8px; min-width: 0; }
  .row-v { font: 500 clamp(36px, 3.6vw, 52px) / .95 var(--display); letter-spacing: -.035em; color: var(--text); white-space: nowrap; font-variant-numeric: lining-nums proportional-nums; }
  .row-v :global(.fn) { vertical-align: top; margin-top: .1em; }
  .row-l { font: 400 13px / 18px var(--ui); color: var(--text-2); max-width: 30ch; }
  .row-scope { display: inline-block; margin-left: 8px; padding: 3px 8px; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--text-2); vertical-align: 1px; }

  .row-d { grid-column: 7 / 13; }
  .row-s {
    display: grid; grid-template-columns: 1fr auto; grid-template-rows: auto auto; column-gap: 16px; row-gap: 6px;
    min-height: 44px; padding: 4px 0; cursor: pointer; list-style: none; border-radius: 8px;
  }
  .row-s::-webkit-details-marker { display: none; }
  .row-t { font: 500 17px / 1.35 var(--ui); color: var(--text); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: .22em; transition: text-decoration-color var(--dur-fast) ease-out; }
  .row-org { grid-row: 2; }
  .row-i { grid-column: 2; grid-row: 1 / 3; align-self: center; position: relative; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line-strong); transition: background-color var(--dur-fast) ease-out, border-color var(--dur-fast) ease-out, transform var(--dur-fast) ease-out; }
  .row-i::before, .row-i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; margin: -.75px 0 0 -5px; border-radius: 1px; background: var(--text-2); transition: transform var(--dur-ui) var(--ease-out); }
  .row-i::after { transform: rotate(90deg); }
  .row-d[open] .row-i::after { transform: rotate(0deg); }
  .row-d[open] .row-i { border-color: rgb(243 238 228 / .24); }
  .row-did { margin-top: 14px; font-size: 15px; line-height: 1.55; max-width: 58ch; }
  @media (hover: hover) and (pointer: fine) {
    .row-s:hover .row-t { text-decoration-color: var(--accent); }
    .row-s:hover .row-i { background: rgb(255 250 240 / .05); }
  }
  .row-s:active .row-i { transform: scale(.94); }

  @media (max-width: 899px) {
    .row { padding: 24px 0 26px; row-gap: 18px; }
    .row-main, .row-d { grid-column: 1 / -1; }
    .row-figs { gap: 16px 28px; }
  }
</style>
