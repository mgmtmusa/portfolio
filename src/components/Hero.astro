---
// Direction C, "Cover line": an inverted magazine cover. Contract: .impeccable/surfaces/src-pages-index-astro.md
import { portraitSources } from '../lib/portrait';
import Footnote from './Footnote.astro';
import { site, cases, growthWork } from '../data/site';
import { notes } from '../data/notes';

// Proof figures come from site.ts (F5: each carries data-fact so the facts gate can trace it).
const [cpa, leads] = cases.find((c) => c.slug === 'evitech')!.results;
const closed = growthWork.flatMap((g) => g.results).find((r) => r.v === '$2M+')!;
const audience = growthWork.flatMap((g) => g.results).find((r) => r.v === '400 → 13,200')!.v.split(' → ')[1];

// One picture, built by hand so each format gets its own quality. The LCP: Base.astro preloads the same srcset and sizes
// (character for character, so WebKit reuses the preload), and decoding="sync" paints it in the masthead's first frame
// (creative director r3, fix 1: with "async" WebKit painted it a frame or two after the name).
const pic = await portraitSources();
const alt =
  'Studio portrait of Musa Abdullah Walid: a bearded man with swept-back black hair and gold wire-framed glasses, in a navy pinstripe double-breasted suit, white shirt and patterned tie.';
---

<header class="hero" data-hero>
  <div class="stage">
    <h1 class="mast">
      <span class="mast-l1" data-line="1">Musa Abdullah</span>
      <span class="mast-l2" data-line="2">Walid</span>
    </h1>

    <div class="lead">
      <p class="role">{site.role}, {site.city}</p>
      <p class="line">I carried a sales target <br />first, so I judge <br />marketing by what closes.</p>
      <div class="acts">
        <a class="cta" href="/contact/" data-hero-cta data-track="contact_click" data-from="hero">Get in touch</a>
        <a class="textlink" href={site.cv} download data-track="cv_download" data-from="hero">Download CV (PDF)</a>
      </div>
    </div>

    <div class="photo" data-dissolve>
      <picture>
        <source type="image/avif" srcset={pic.avif} sizes={pic.sizes} />
        <source type="image/webp" srcset={pic.webp} sizes={pic.sizes} />
        <img
          class="photo-img"
          data-portrait
          src={pic.fallback}
          alt={alt}
          width="620"
          height="620"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </picture>
    </div>

    <div class="slab glass--slab xfade" data-slab aria-hidden="true"></div>
    <div class="slab-shadow" data-slab-shadow aria-hidden="true"></div>
  </div>

  <div class="more">
    <ul class="proof" aria-label="Results">
      <li class="proof-pair">
        <div class="figs">
          <p class="fig" data-fact={cpa.v}>{cpa.v}<Footnote n={1} id="fn-h-1a" note={notes.evitechPair} /></p>
          <p class="fig" data-fact={leads.v}>{leads.v}<Footnote n={1} id="fn-h-1" note={notes.evitechPair} /></p>
        </div>
        <div class="labs">
          <p class="lab">{cpa.l}</p>
          <p class="lab">{leads.l}</p>
        </div>
        <p class="cap">Two results from the same initiative at Evitech, on paid media of roughly $15K to $30K a month.</p>
      </li>
      <li>
        <p class="fig" data-fact={closed.v}>{closed.v}<Footnote n={2} id="fn-h-2" note={notes.closed} /></p>
        <p class="lab">{closed.l}</p>
      </li>
      <li>
        <p class="fig" data-fact={audience}>{audience}<Footnote n={3} id="fn-h-3" note={notes.audience} /></p>
        <p class="lab">social audience for I Heart Uni, grown from 400</p>
      </li>
    </ul>
    <div class="avail" data-hero-avail>
      <p>{site.availability}</p>
      <p>{site.replyTime.text}</p>
    </div>
  </div>
</header>

<style>
  .hero {
    --u: min(calc(100vw / 1440), calc(100svh / 900), 1px);
    position: relative;
    width: min(100%, calc(1440 * var(--u)));
    margin-inline: auto;
    height: max(600px, calc(900 * var(--u)));
  }
  .stage {
    position: absolute; inset: 0;
    /* The slab's fill, shared with the bent copy (below): the copy always paints over the fill, never under it. */
    --slab-fill: radial-gradient(70% 110% at 10% 0%, rgb(255 226 190 / .10), transparent 58%), linear-gradient(180deg, rgb(255 248 236 / .05), rgb(255 248 236 / .015) 60%);
    --slab-inset: inset 0 1px 0 rgb(255 244 224 / .24), inset 1px 0 0 rgb(255 244 224 / .10), inset 0 -12px 24px rgb(6 5 4 / .26);
  }
  .more { position: absolute; inset: 0; pointer-events: none; }
  .more > * { pointer-events: auto; }

  /* Masthead: two title-case lines inside the 58u margins. Line 2 baseline at 847u. */
  .mast {
    position: absolute; left: calc(58 * var(--u)); top: calc(504 * var(--u)); z-index: 3; margin: 0;
    font: 540 calc(213 * var(--u)) / .84 var(--display); letter-spacing: -.045em; color: var(--ink-mast);
  }
  .mast span { display: block; white-space: nowrap; width: max-content; }

  /* Top left, in the key light. */
  .lead { position: absolute; left: calc(58 * var(--u)); top: calc(112 * var(--u)); width: calc(560 * var(--u)); z-index: 5; }
  .role { font: 500 14px / 1.3 var(--ui); color: var(--text-2); margin: 0 0 calc(10 * var(--u)); min-height: calc(14 * var(--u)); }
  .line { font: 480 calc(40 * var(--u)) / 1.06 var(--display); letter-spacing: -.022em; color: var(--text); max-width: calc(548 * var(--u)); }
  .acts { display: flex; align-items: center; gap: 24px; margin-top: calc(32 * var(--u)); }
  .acts .textlink { display: inline-flex; min-height: 44px; align-items: center; }

  /* The portrait: one whole photo, dissolving into the room. Max 620 CSS px. */
  .photo { position: absolute; left: calc(435 * var(--u)); top: calc(3 * var(--u)); width: calc(620 * var(--u)); height: calc(620 * var(--u)); z-index: 2; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* Cover lines, right of his head, on column 10. */
  .proof { position: absolute; left: calc(1069 * var(--u)); top: calc(128 * var(--u)); width: calc(313 * var(--u)); display: grid; gap: calc(24 * var(--u)); z-index: 5; }
  .figs, .labs { display: grid; grid-template-columns: 1fr 1fr; column-gap: 20px; }
  .fig { font: 500 calc(36 * var(--u)) / 1 var(--display); letter-spacing: -.03em; color: var(--text); white-space: nowrap; font-variant-numeric: lining-nums proportional-nums; }
  .fig :global(.fn) { vertical-align: top; margin-top: .05em; }
  .lab { font: 400 13px / 18px var(--ui); color: var(--text-2); margin-top: 6px; }
  .labs .lab { margin-top: 6px; }
  .cap { font: 400 13px / 18px var(--ui); color: var(--text-2); margin-top: 10px; }

  /* Availability, verbatim, bottom-aligned to the "Walid" baseline. */
  .avail {
    position: absolute; left: calc(1069 * var(--u)); width: calc(313 * var(--u)); bottom: calc(53 * var(--u) - 5px);
    display: grid; gap: 6px; font: 400 14px / 1.45 var(--ui); color: var(--text-2); z-index: 5; text-wrap: balance;
  }

  /* The slab: 360×241u at x 612, y 452 (bottom edge on the cap line of "Walid"). */
  .slab {
    --slab-r: calc(52 * var(--u));
    --rim: .80;
    position: absolute; left: calc(612 * var(--u)); top: calc(452 * var(--u)); width: calc(360 * var(--u)); height: calc(241 * var(--u));
    border-radius: var(--slab-r); z-index: 6; cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none;
    background: var(--slab-fill);
    box-shadow: var(--slab-inset), 0 0 0 1px rgb(6 5 4 / .45);
    transition: --rim var(--dur-fast) ease-out, -webkit-backdrop-filter 120ms ease-out, backdrop-filter 120ms ease-out;
  }
  .slab::before { padding: 1.5px; }
  /* Press: the glass is pushed toward the page, so its contact shadow tightens. No scale: a scaled slab would pull
     its bent copy off the cut-out under it. */
  .slab:active { cursor: grabbing; }
  .slab:active ~ .slab-shadow { transform: translate(calc(5 * var(--u)), calc(8 * var(--u))); }
  /* In flight the bend eases out and a light blur eases in (120ms), and back on landing. */
  .slab[data-moving] { -webkit-backdrop-filter: blur(4px) saturate(160%) brightness(1.08); backdrop-filter: blur(4px) saturate(160%) brightness(1.08); }
  .slab[data-moving]::after { opacity: 0; }
  /* The bent copy sits in the page under the slab (bend.ts): it scrolls with the masthead, so it stays in register with
     the originals in every frame. Same layer as the slab, just before it, so the glass paints over it. */
  .stage :global(svg.bend) { position: absolute; overflow: hidden; pointer-events: none; z-index: 6; background: var(--slab-fill); box-shadow: var(--slab-inset); }
  /* While the copy shows, it carries the fill under itself (as when it lived inside the slab); the slab keeps its rims. */
  .slab[data-bend='on'] { background: none; box-shadow: 0 0 0 1px rgb(6 5 4 / .45); }
  .slab-shadow {
    position: absolute; left: calc(612 * var(--u)); top: calc(452 * var(--u)); width: calc(360 * var(--u)); height: calc(241 * var(--u));
    /* Under the masthead (z 3), over the portrait (same z, later in the DOM): the contact shadow never dims the name, so
       on touch, where the bend is off while the slab moves, the letters under the slab keep full ink (CD r2, fix 6a). */
    border-radius: calc(52 * var(--u)); z-index: 2; pointer-events: none;
    background: rgb(var(--shadow-ink) / .25); filter: blur(calc(28 * var(--u)));
    transform: translate(calc(10 * var(--u)), calc(16 * var(--u)));
    transition: transform var(--dur-fast) ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .slab:hover { --rim: .95; }
    .slab:hover:not(:active) ~ .slab-shadow { transform: translate(calc(14 * var(--u)), calc(22 * var(--u))); }
  }
  @property --rim { syntax: '<number>'; inherits: true; initial-value: .35; }

  /* Before first paint the slab waits off to the left (the glide brings it in). Arriving by a view transition
     (html.soft-nav, Base.astro) there is no entrance: the slab is simply at rest. */
  :global(html.js:not([data-motion='reduce']):not(.soft-nav)) .slab,
  :global(html.js:not([data-motion='reduce']):not(.soft-nav)) .slab-shadow { opacity: 0; translate: calc(-240 * var(--u)) 0; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js:not([data-motion='reduce']):not(.soft-nav)) .slab, :global(html.js:not([data-motion='reduce']):not(.soft-nav)) .slab-shadow { opacity: 1; translate: none; }
  }
  /* Accessibility fallbacks: nothing covers the name. */
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more), (forced-colors: active) {
    .slab, .slab-shadow { display: none !important; }
  }

  /* Entrances: content is visible by default; motion only adds the rise. Never on the masthead or portrait.
     The rise runs from first paint (no hold, so text never sits 8px low and then jumps), before the slab's glide
     at 400ms; only on a full load, never on a view-transition return. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='reduce']):not(.soft-nav)) .lead { animation: rise 500ms var(--ease-out) both; }
    :global(html:not([data-motion='reduce']):not(.soft-nav)) .proof > li { animation: rise 500ms var(--ease-out) both; }
    :global(html:not([data-motion='reduce']):not(.soft-nav)) .proof > li:nth-child(1) { animation-delay: 150ms; }
    :global(html:not([data-motion='reduce']):not(.soft-nav)) .proof > li:nth-child(2) { animation-delay: 220ms; }
    :global(html:not([data-motion='reduce']):not(.soft-nav)) .proof > li:nth-child(3) { animation-delay: 290ms; }
    :global(html:not([data-motion='reduce']):not(.soft-nav)) .avail { animation: rise 400ms var(--ease-out) 300ms both; }
  }
  @keyframes rise { from { transform: translateY(8px); } }

  /* Below 1440px wide the cover lines start higher, so the column clears the cap line of "Abdullah" by 24u. */
  @media (max-width: 1439px) and (min-width: 640px) {
    .proof { top: calc(88 * var(--u)); }
  }

  /* Below 1180px: figure pairs stack, labels keep a readable measure. */
  @media (max-width: 1179px) and (min-width: 640px) {
    .figs, .labs { grid-template-columns: 1fr; }
    .proof-pair { display: grid; grid-template-columns: auto 1fr; column-gap: 16px; }
    .proof-pair .figs { grid-row: 1; }
    .proof-pair .labs { grid-row: 1; }
    .proof-pair .labs .lab { min-height: calc(36 * var(--u)); display: flex; align-items: center; margin: 0; }
    .proof-pair .cap { grid-column: 1 / -1; }
    .lab { min-width: 14ch; }
    /* Availability: x 996 to 1382u, clear of the slab, so it stays short and sits below line 1's baseline. */
    .avail { left: calc(996 * var(--u)); width: calc(386 * var(--u)); }
  }

  /* Phone: 390 grid, first viewport 664px. */
  @media (max-width: 639px) {
    .hero { --p: calc(100vw / 390); width: 100%; height: auto; }
    .stage { position: relative; height: calc(680 * var(--p)); }
    .more { position: relative; inset: auto; padding: 24px 20px 0; display: grid; gap: 40px; }
    .mast { left: calc(20 * var(--p)); top: calc(397 * var(--p)); font-size: calc(78 * var(--p)); letter-spacing: -.04em; }
    .mast .mast-l1 { white-space: normal; width: auto; max-width: calc(350 * var(--p)); }
    .lead { left: calc(20 * var(--p)); top: calc(38 * var(--p)); width: calc(350 * var(--p)); }
    .role { font-size: 13px; margin-bottom: 6px; min-height: 0; }
    .line { font-size: 26px; line-height: 1.08; letter-spacing: -.018em; max-width: none; }
    .acts { position: absolute; top: calc(566 * var(--p)); left: 0; margin: 0; gap: 20px; }
    /* The photo's own dissolve finishes inside its box: an elliptical mask, so every edge meets the page within a
       level and the suit never ends on a straight line. bend.ts gives the slab's copy the same mask (--dsv-*). */
    .photo {
      left: calc(55 * var(--p)); top: calc(148 * var(--p)); width: calc(280 * var(--p)); height: calc(280 * var(--p));
      --dsv-rx: 50; --dsv-ry: 50; --dsv-cx: 50; --dsv-cy: 46; --dsv-solid: 62;
      /* Same numbers as --dsv-* (WebKit drops a gradient built from calc(var()) sizes). */
      -webkit-mask-image: radial-gradient(50% 50% at 50% 46%, #000 62%, transparent 100%);
      mask-image: radial-gradient(50% 50% at 50% 46%, #000 62%, transparent 100%);
    }
    .photo :global(img) { position: absolute; left: calc(-21 * var(--p)); top: calc(-14 * var(--p)); width: calc(351 * var(--p)); height: calc(351 * var(--p)); max-width: none; }
    .slab, .slab-shadow { left: calc(100 * var(--p)); top: calc(428 * var(--p)); width: calc(210 * var(--p)); height: calc(130 * var(--p)); border-radius: 32px; --slab-r: 32px; }
    .proof { position: static; width: auto; grid-template-columns: 1fr 1fr; gap: 28px 20px; }
    .proof-pair { grid-column: 1 / -1; }
    .fig { font-size: 30px; }
    .avail { position: static; width: auto; order: -1; }
  }
  /* 320 to 359px (Display Zoom, small Androids): the line keeps three rows at Host's 24px floor, and the portrait
     moves down 12px so the last descender clears the hair by 16px (creative director, round 1). */
  @media (max-width: 359px) {
    .line { font-size: 24px; }
    .photo { top: calc(148 * var(--p) + 12px); }
  }
</style>
