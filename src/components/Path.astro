---
// The path: four roles at Evitech, set as a staircase. Each rung carries the metric earned in that role.
import { career } from '../data/site';
import Footnote from './Footnote.astro';
import { notes } from '../data/notes';
const rungs = [
  { fig: 'Day one', unit: 'the company’s highest day-one sales record' },
  { fig: '$2M+', unit: 'in B2B contracts personally closed to date', note: { n: 2, id: 'fn-path-closed', note: notes.closed } },
  { fig: '23', unit: 'sales executives recruited for the NSW hub', note: { n: 4, id: 'fn-path-hub', note: notes.hub } },
  { fig: '$15K to $30K', unit: 'a month in paid media, across Meta and Google', note: { n: 5, id: 'fn-path-spend', note: notes.spend } },
];
---

<section class="path wrap" aria-labelledby="path-h">
  <h2 class="h1 path-h" id="path-h">From <span class="nobr">door-to-door</span> sales to marketing, in four roles</h2>
  <p class="body path-intro">I joined Evitech in field sales and held three roles there before moving into marketing.</p>
  <div class="rungs-wrap">
  <div class="path-light" data-path-light data-rung="0" aria-hidden="true"></div>
  <ol class="rungs">
    {
      career.map((r, i) => (
        <li class="rung" style={`--i:${i}`}>
          <div class="rung-in">
            <p class="label rung-when">{r.when}</p>
            <p class="rung-fig">{rungs[i].fig}{rungs[i].note && <Footnote {...rungs[i].note} />}</p>
            <p class="rung-unit">{rungs[i].unit}</p>
            <h3 class="rung-t">{r.t}</h3>
            <p class="body rung-d">{r.short}</p>
          </div>
        </li>
      ))
    }
  </ol>
  </div>
</section>

<style>
  .path { position: relative; }
  .nobr { white-space: nowrap; }
  /* The key light (creative director r2, fixes 1 and 2): one --key pool that moves to the rung being read. The box holds
     the whole circle, so it reaches zero before every edge; no max-width (body clips sideways overflow). Its resting
     place, with no script, is the first rung's figure (centre 40px left of and 60px above it); the script only sets
     translate. One element, translate only, no idle drift; under reduced motion it jumps. */
  .rungs-wrap { position: relative; margin-top: 72px; }
  .path-light {
    /* Radius capped on narrow phones so the box stays inside the viewport (see CaseTeasers.astro). */
    --r: min(400px, calc(100vw - 48px));
    position: absolute; z-index: -1; left: calc(-40px - var(--r)); top: calc(8px - var(--r));
    width: calc(2 * var(--r)); height: calc(2 * var(--r)); max-width: none; pointer-events: none;
    background: radial-gradient(closest-side, rgb(var(--key) / .05), transparent);
    transition: translate 900ms cubic-bezier(.16, 1, .3, 1);
  }
  /* Creative director r3, fix 2: brighter from 768px so the moment survives a screen recording; phones keep .05. */
  @media (min-width: 768px) { .path-light { background: radial-gradient(closest-side, rgb(var(--key) / .07), transparent); } }
  @media (prefers-reduced-motion: reduce) { .path-light { transition: none; } }
  :global(html[data-motion='reduce']) .path-light { transition: none; }
  .path { padding-top: 160px; }
  .path-h { max-width: 14ch; scroll-margin-top: 72px; }
  .path-intro { margin-top: 24px; }
  .rung { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); border-top: 1px solid var(--line); }
  .rung-in { grid-column: calc(1 + var(--i) * 2) / span 6; display: grid; gap: 10px; padding: 28px 0 36px; }
  .rung-fig { margin-top: 12px; font: 500 clamp(44px, 5.4vw, 80px) / .95 var(--display); letter-spacing: -.04em; white-space: nowrap; }
  .rung-fig :global(.fn) { vertical-align: top; margin-top: .1em; margin-left: .06em; }
  .rung-unit { color: var(--text-2); font-size: 15px; }
  .rung-t { font: 500 18px / 1.3 var(--ui); margin-top: 14px; }
  .rung-d { font-size: 15px; max-width: 48ch; }
  @media (max-width: 1023px) {
    .rung-in { grid-column: 1 / -1; grid-template-columns: minmax(0, 1fr); padding-left: calc(var(--i) * 14px); }
    .rung-fig { font-size: clamp(44px, 12vw, 72px); }
  }
  /* Creative director r3, fix 7: on phones a 14px step reads as misalignment, so every rung sits on the edge and the
     light moves vertically only. The staircase holds from 640px up. */
  @media (max-width: 639px) { .rung-in { padding-left: 0; } }
  /* Below 360px the widest figure (with its marker) is wider than the column, so let it wrap. */
  @media (max-width: 359px) { .rung-fig { white-space: normal; } }
</style>

<script>
  // The key light follows the reading: the rung crossing the band 35% to 45% down the viewport gets the light.
  let stop: (() => void) | null = null;
  function initPathLight() {
    stop?.();
    stop = null;
    const light = document.querySelector<HTMLElement>('[data-path-light]');
    if (!light) return;
    const rungs = [...document.querySelectorAll<HTMLElement>('.path .rung')];
    let cur = 0;
    const go = (i: number) => {
      cur = i;
      const fig = rungs[i]?.querySelector<HTMLElement>('.rung-fig');
      const host = light.offsetParent as HTMLElement | null;
      if (!fig || !host) return;
      const f = fig.getBoundingClientRect(), h = host.getBoundingClientRect();
      // Centre 40px left of and 60px above the figure's top-left, from the light's own untranslated box.
      const x = f.left - h.left - 40 - (light.offsetLeft + light.offsetWidth / 2);
      const y = f.top - h.top - 60 - (light.offsetTop + light.offsetHeight / 2);
      light.style.translate = `${x.toFixed(1)}px ${y.toFixed(1)}px`;
      light.dataset.rung = String(i);
    };
    // First placement is exact and instant (the CSS rest point is only an estimate of the first figure). It waits for
    // the observer's first callback (motion r3, fix 2): a restored scroll or a view-transition return to mid-Path
    // finds the light already on the rung being read, never sweeping in from rung 0 like a replayed entrance.
    // The rung being read is the last one whose top has passed the bottom of the band (45% down the viewport).
    const reading = () => {
      const edge = innerHeight * 0.45;
      let i = 0;
      rungs.forEach((r, k) => { if (r.getBoundingClientRect().top <= edge) i = k; });
      return i;
    };
    light.style.transition = 'none';
    go(reading());
    let first = true;
    const io = new IntersectionObserver((entries) => {
      if (first) {
        first = false;
        go(reading());
        void light.offsetWidth;
        light.style.transition = '';
        return;
      }
      for (const e of entries) if (e.isIntersecting) go(rungs.indexOf(e.target as HTMLElement));
    }, { rootMargin: '-35% 0px -55% 0px' });
    rungs.forEach((r) => io.observe(r));
    const onResize = () => go(cur);
    addEventListener('resize', onResize);
    stop = () => { io.disconnect(); removeEventListener('resize', onResize); };
  }
  document.addEventListener('astro:page-load', initPathLight);
  document.addEventListener('astro:before-swap', () => { stop?.(); stop = null; });
</script>
