---
import type { Case } from '../data/site';

interface Props {
  c: Case;
  /** Position in the hero hand (0-based) — only used by the hand layout. */
  i?: number;
  /** hand: hero fan · flat: linked card in page flow · still: decorative copy on its own case page */
  variant?: 'hand' | 'flat' | 'still';
}
const { c, i = 0, variant = 'flat' } = Astro.props;
const Tag = variant === 'still' ? 'div' : 'a';
---

<Tag
  class={`card card-${c.card.tone} card-${variant === 'hand' ? 'hand' : 'flat'}`}
  href={variant === 'still' ? undefined : `/work/${c.slug}/`}
  aria-hidden={variant === 'still' ? 'true' : undefined}
  style={variant === 'hand' ? `--i:${i}` : undefined}
>
  <span class="card-in">
    <span class="card-org">{c.org}</span>
    <span class="card-title">{c.title}</span>
    <span class="card-stat"><b>{c.card.v}</b> {c.card.l}</span>
    {variant !== 'still' && <span class="card-cta">Read the case study</span>}
  </span>
</Tag>
