---
import Base from '../layouts/Base.astro';
import { site, cases } from '../data/site';
---

<Base title={`Page not found — ${site.name}`} path="/404/" noindex>
  <section class="notfound" aria-labelledby="nf-h">
    <h1 class="case-title" id="nf-h">This page doesn’t exist</h1>
    <p class="case-summary">The link may be out of date. Here’s where to go instead.</p>
    <ul class="ticks">
      <li><a class="link" href="/">Home page</a></li>
      {cases.map((c) => <li><a class="link" href={`/work/${c.slug}/`}>{c.org} case study</a></li>)}
    </ul>
  </section>
</Base>
