---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { site, cases, career, approach, experience, capabilities, tools, recognition, caseBySlug } from '../data/site';

const [lead, ...rest] = cases;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  sameAs: [site.linkedin],
  worksFor: { '@type': 'Organization', name: 'Evitech Pty Ltd' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Melbourne' },
  address: { '@type': 'PostalAddress', addressLocality: 'Melbourne', addressRegion: 'VIC', addressCountry: 'AU' },
  knowsLanguage: ['English', 'Bengali', 'Hindi'],
};
---

<Base title={`${site.name} — ${site.role}, ${site.city}`} path="/" jsonLd={jsonLd}>
  <!-- ───────── Hero ───────── -->
  <section class="hero" id="top" aria-labelledby="hero-name">
    <div class="hero-copy">
      <h1 class="hero-name" id="hero-name">
        <span>Musa</span>
        <span>Abdullah</span>
        <span>Walid</span>
      </h1>
      <p class="hero-role">Marketing &amp; Growth Specialist in Melbourne</p>
      <p class="hero-angle">
        I came up through sales — door to door, then $2M+ in B2B contracts — so I build marketing around what a lead is
        actually worth.
      </p>
      <div class="hero-actions">
        <a class="btn btn-ink" href="#work">View selected work</a>
        <a class="link" href={`mailto:${site.email}`}>or email me</a>
      </div>
    </div>

    <nav class="hand" aria-label="Case studies">
      <div class="hand-in">
        {cases.map((c, i) => <CaseCard c={c} i={i} variant="hand" />)}
      </div>
    </nav>
  </section>

  <!-- ───────── Selected work ───────── -->
  <section class="work" id="work" aria-labelledby="work-h">
    <h2 class="h2" id="work-h">Selected work</h2>

    <article class="feature">
      <div class="feature-body">
        <p class="meta">{lead.org}, {lead.when}</p>
        <h3 class="h3">{lead.title}</h3>
        <p class="lede">{lead.summary}</p>
        <dl class="results">
          {
            lead.results.slice(0, 2).map((r) => (
              <div>
                <dt>{r.l}</dt>
                <dd>{r.v}</dd>
              </div>
            ))
          }
        </dl>
        <a class="link" href={`/work/${lead.slug}/`}>Read the Evitech case study</a>
      </div>
    </article>

    <div class="pair">
      {
        rest.map((c) => (
          <article class="tile">
            <p class="meta">
              {c.org}, {c.when}
            </p>
            <h3 class="h3">{c.title}</h3>
            <p>{c.summary}</p>
            <dl class="results results-sm">
              {c.results.slice(0, 2).map((r) => (
                <div>
                  <dt>
                    {r.l}
                    {r.scope && <span class="scope"> ({r.scope.toLowerCase()})</span>}
                  </dt>
                  <dd>{r.v}</dd>
                </div>
              ))}
            </dl>
            <a class="link" href={`/work/${c.slug}/`}>
              Read the case study<span class="sr">: {c.org}</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ───────── Approach ───────── -->
  <section class="approach" id="approach" aria-labelledby="ap-h">
    <h2 class="h2" id="ap-h">How sales shapes my marketing</h2>
    <div class="approach-grid">
      {
        approach.map((a) => (
          <div class="principle">
            <h3 class="h4">{a.t}</h3>
            <p>{a.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ───────── Career ───────── -->
  <section class="career" id="career" aria-labelledby="ca-h">
    <div class="career-in">
      <div class="career-copy">
        <h2 class="h2" id="ca-h">From the sales floor to growth</h2>
        <p class="career-sub">Four roles at Evitech since April 2021: three promotions in under two years.</p>
        <ol class="rungs">
          {
            career.map((r) => (
              <li class="rung">
                <p class="rung-when">{r.when}</p>
                <h3 class="rung-t">{r.t}</h3>
                <p class="rung-d">
                  {r.d}
                  {r.link && (
                    <>
                      {' '}
                      <a class="link" href={r.link.href}>
                        {r.link.label}
                      </a>
                    </>
                  )}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="stairs-wrap" aria-hidden="true">
        <div class="stairs">
          {
            career.map((_, i) => (
              <div class={`blk${i === career.length - 1 ? ' blk-top' : ''}`} style={`--i:${i}`}>
                <div class="f f-top" />
                <div class="f f-front" />
                <div class="f f-side" />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Experience ───────── -->
  <section class="exp" id="experience" aria-labelledby="ex-h">
    <h2 class="h2" id="ex-h">Experience</h2>
    <ol class="exp-list">
      {
        experience.map((e) => (
          <li class="exp-row">
            <span class="exp-when">{e.when}</span>
            <span class="exp-role">{e.role}</span>
            <span class="exp-org">{e.org}</span>
            <span class="exp-note">
              {e.note}
              {e.note && e.case && ' '}
              {e.case && (
                <a class="link" href={`/work/${e.case}/`}>
                  Case study<span class="sr">: {caseBySlug(e.case).title}</span>
                </a>
              )}
            </span>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ───────── Capabilities ───────── -->
  <section class="caps" aria-labelledby="cp-h">
    <h2 class="h2" id="cp-h">What I bring</h2>
    <div class="caps-grid">
      {
        capabilities.map((c) => (
          <div class="cap">
            <h3 class="h4">{c.t}</h3>
            <p>{c.items}.</p>
            <p class="cap-seen">
              Shown in{' '}
              {c.cases.map((slug, i) => (
                <>
                  {i > 0 && ' and '}
                  <a class="link" href={`/work/${slug}/`}>
                    {caseBySlug(slug).org}
                  </a>
                </>
              ))}
            </p>
          </div>
        ))
      }
    </div>
    <p class="tools"><span class="tools-h">Tools I use:</span> {tools.join(', ')}.</p>
  </section>

  <!-- ───────── Background ───────── -->
  <section class="bg" aria-labelledby="bg-h">
    <h2 class="h2" id="bg-h">Background</h2>
    <div class="bg-grid">
      <div>
        <h3 class="h4">Education</h3>
        <p>Bachelor of Commerce, majoring in Marketing and Accounting. University of Melbourne, graduated 2025.</p>
        <h3 class="h4">Languages</h3>
        <p>English and Bangla (native), Hindi (fluent).</p>
        <h3 class="h4">Leadership</h3>
        <p>President of the Multicultural and Multi-Faith Club at Trinity College, University of Melbourne, 2019 to 2021.</p>
      </div>
      <div>
        <h3 class="h4">Debating and international forums</h3>
        <ul class="recog">
          {
            recognition.map((r) => (
              <li>
                <span class="recog-when">{r.when}</span>
                <span>
                  <b>{r.t}.</b> {r.d}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>
