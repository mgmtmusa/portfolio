---
import Base from '../layouts/Base.astro';
import Split from '../components/Split.astro';
import { site, impact, ladder, experience, disciplines, tools, recognition } from '../data/site';
const pad = (n: number) => String(n).padStart(2, '0');
const fmt = (x: (typeof impact)[number]) => `${x.pre}${x.dec ? x.v.toFixed(x.dec) : x.v}${x.suf}`;
---

<Base>
  <a class="skip" href="#main">Skip to content</a>
  <div class="progress" aria-hidden="true"></div>

  <header class="bar">
    <a class="bar-name" href="#top">{site.name}</a>
    <p class="bar-meta">{site.role} Specialist<br />{site.location}</p>
    <nav class="bar-nav" aria-label="Primary">
      <a href="#impact">Impact</a>
      <a href="#story">Story</a>
      <a href="#experience">Experience</a>
      <a href="#skills">Skills</a>
    </nav>
    <p class="bar-time">Local time<br /><time data-clock>--:--</time></p>
    <a class="bar-cta" href="#contact">Get in touch ↗</a>
  </header>

  <main id="main">
    <!-- ───────── HERO ───────── -->
    <section class="hero" id="top">
      <p class="cap cap-l">
        <span class="lbl">Now</span>
        Marketing &amp; Growth Specialist at Evitech. I turn campaign data into decisions.
      </p>
      <p class="cap cap-r">
        <span class="lbl">Before</span>
        I came up through sales — from door-to-door to $2M+ in B2B contracts closed.
      </p>

      <!-- 3D: a player card with real thickness, with a deck of cards fanned behind it -->
      <div class="stage" aria-hidden="true">
        <div class="scene">
          <div class="card-flip">
            <div class="card-tilt">
              <div class="face front">
                <div class="fc-top"><span>No. 01</span><span>Melbourne</span></div>
                <div class="fc-mono">MW</div>
                <div class="fc-name">Musa<br />Abdullah Walid</div>
                <div class="fc-stats">
                  <span><b>28%</b>Lower CPA</span>
                  <span><b>65%</b>More leads</span>
                  <span><b>$2M+</b>Closed</span>
                </div>
                <div class="fc-band">Marketing &amp; Growth · BCom UniMelb</div>
              </div>
              {Array.from({ length: 6 }, (_, i) => <div class="edge" style={`--z:${-(i + 1) * 0.9}px`}></div>)}
              <div class="face back">
                <div class="fc-top"><span>The roster</span><span>2017 — Now</span></div>
                <ol class="fb-list">
                  <li><b>Evitech</b>Sales → Marketing &amp; Growth</li>
                  <li><b>I Heart Uni</b>Brand Manager &amp; Lead MC</li>
                  <li><b>The Lil Project</b>Event Coordinator</li>
                  <li><b>UniMelb</b>Commerce Ambassador</li>
                  <li><b>Roger David</b>118% of target</li>
                </ol>
                <div class="fb-foot">English · Bangla · Hindi</div>
              </div>
            </div>
          </div>
          <div class="deck">
            <div class="dk dk-1" style="--n:1"><span class="dk-org">Evitech</span><span class="dk-v">$2M+</span><span class="dk-l">B2B closed</span></div>
            <div class="dk dk-2" style="--n:2"><span class="dk-org">I Heart Uni</span><span class="dk-v">13.2K</span><span class="dk-l">Audience built</span></div>
            <div class="dk dk-3" style="--n:3"><span class="dk-org">The Lil Project</span><span class="dk-v">768</span><span class="dk-l">Children reached</span></div>
          </div>
        </div>
      </div>

      <h1 class="name">
        <span class="name-l"><Split tag="span" mode="css" text="Musa Abdullah" /></span>
        <span class="name-l name-l2"><Split tag="span" mode="css" text="Walid" /><span class="name-role" aria-hidden="true">Marketing &amp;<br />Growth</span></span>
      </h1>
    </section>

    <!-- ───────── STATEMENT ───────── -->
    <section class="statement" aria-labelledby="st-h">
      <h2 id="st-h" class="lbl">( Profile )</h2>
      <Split tag="p" mode="scrub" class="st-text" text="I came up through sales, so I know what a lead is *worth.* Now I build the marketing that brings them in." />
    </section>

    <!-- ───────── IMPACT ───────── -->
    <section class="impact" id="impact" aria-labelledby="im-h">
      <div class="sec-head">
        <p class="lbl">( Key impact )</p>
        <Split tag="h2" id="im-h" class="sec-title" text="The *numbers.*" />
      </div>
      <ul class="stats">
        {
          impact.map((x) => (
            <li class="stat">
              <span class="stat-v" data-count={x.v} data-pre={x.pre} data-suf={x.suf} data-dec={x.dec ?? 0}>{fmt(x)}</span>
              <span class="stat-l">{x.l}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ───────── LADDER (3D) ───────── -->
    <section class="ladder" id="story" aria-labelledby="ld-h">
      <div class="ladder-pin">
        <div class="ladder-copy">
          <p class="lbl lbl-inv">Evitech Pty Ltd · Energy efficiency, solar &amp; HVAC · Apr 2021 — Now</p>
          <Split tag="h2" class="ld-title" text="A promotion *every year.*" />
          <ol class="rungs">
            {
              ladder.map((r, i) => (
                <li class="rung" style={`--i:${i}`}>
                  <span class="rung-n">{r.when}</span>
                  <span class="rung-t">{r.t}</span>
                  <span class="rung-d">{r.d}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="stairs-wrap" aria-hidden="true">
          <div class="stairs">
            {
              ladder.map((_, i) => (
                <div class={`blk${i === ladder.length - 1 ? ' blk-top' : ''}`} style={`--i:${i}`}>
                  <div class="f f-top"><span>{pad(i + 1)}</span></div>
                  <div class="f f-front"></div>
                  <div class="f f-side"></div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── EXPERIENCE ───────── -->
    <section class="exp" id="experience" aria-labelledby="ex-h">
      <div class="sec-head">
        <p class="lbl">( Experience · 2017 — Now )</p>
        <Split tag="h2" id="ex-h" class="sec-title" text="Where I’ve *worked.*" />
      </div>
      <ol class="exp-list">
        {
          experience.map((e) => (
            <li class="row">
              <span class="row-when">{e.when}</span>
              <span class="row-role">{e.role}</span>
              <span class="row-org">
                {e.href ? <a href={e.href} rel="noopener noreferrer" target="_blank">{e.org} ↗</a> : e.org}
              </span>
              <span class="row-note">{e.note}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ───────── SKILLS ───────── -->
    <section class="skills" id="skills" aria-labelledby="sk-h">
      <div class="sec-head">
        <p class="lbl">( Core skills )</p>
        <Split tag="h2" id="sk-h" class="sec-title" text="Four *disciplines.*" />
      </div>
      <div class="arenas">
        {
          disciplines.map((a) => (
            <article class="arena">
              <div class="arena-in">
                <span class="arena-n">{a.n}</span>
                <h3 class="arena-t">{a.t}</h3>
                <p class="arena-lede">{a.lede}</p>
                <ul class="arena-list">
                  {a.skills.map((s) => <li>{s}</li>)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
      <div class="tools">
        <p class="lbl">Tools</p>
        <ul class="tool-list">{tools.map((t) => <li>{t}</li>)}</ul>
      </div>
    </section>

    <!-- ───────── RECOGNITION ───────── -->
    <section class="recog" aria-labelledby="rc-h">
      <div class="sec-head">
        <p class="lbl">( International recognition )</p>
        <Split tag="h2" id="rc-h" class="sec-title" text="Represented *Bangladesh.*" />
      </div>
      <ol class="rc-list">
        {
          recognition.map((r) => (
            <li class="rc">
              <span class="row-when">{r.when}</span>
              <span class="rc-t">{r.t}</span>
              <span class="rc-d">{r.d}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ───────── CREDENTIALS ───────── -->
    <section class="creds" aria-labelledby="cr-h">
      <h2 id="cr-h" class="sr">Education, languages and interests</h2>
      <div class="cred">
        <span class="lbl">Education</span>
        <p class="cred-big">Bachelor of Commerce</p>
        <p class="cred-sub">Marketing &amp; Accounting · University of Melbourne · Graduated 2025</p>
      </div>
      <div class="cred">
        <span class="lbl">Languages</span>
        <p class="cred-big">English, Bangla, Hindi</p>
        <p class="cred-sub">Native English &amp; Bangla · fluent Hindi</p>
      </div>
      <div class="cred">
        <span class="lbl">Off the clock</span>
        <p class="cred-big">Music, fashion, food</p>
        <p class="cred-sub">And the practical use of AI in marketing</p>
      </div>
    </section>
  </main>

  <!-- ───────── CONTACT ───────── -->
  <footer class="footer" id="contact">
    <div class="footer-in">
      <p class="lbl lbl-foot">( Contact · Full Australian working rights )</p>
      <Split tag="p" class="foot-title" text="Need growth that sales *can feel?*" />
      <a class="mail" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a>
      <div class="foot-row">
        <ul class="socials">
          {site.socials.map((s) => <li><a href={s.href} rel="noopener noreferrer" target="_blank">{s.label} ↗</a></li>)}
        </ul>
        <p>{site.location} · <time data-clock>--:--</time></p>
        <a href="#top">Back to top ↑</a>
      </div>
      <p class="legal">© {site.year} {site.name}</p>
    </div>
  </footer>
</Base>
