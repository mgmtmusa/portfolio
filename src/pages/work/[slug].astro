---
// /work/<slug>/: a real page for each case (Task 7). The work index sits underneath, inert and unnamed, and the
// sheet is open over it, so a cold deep link, a reload and a no-JavaScript visit all show the same thing.
// Title, description and share card come from src/lib/meta.ts (story.md section 6).
import Base from '../../layouts/Base.astro';
import WorkIndex from '../../components/WorkIndex.astro';
import CaseSheet from '../../components/CaseSheet.astro';
import { cases } from '../../data/site';
import type { CoverSlug } from '../../lib/work';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug } }));
}
const slug = Astro.params.slug as CoverSlug;
---

<Base path={`/work/${slug}/`}>
  <div class="under" data-sheet-under inert aria-hidden="true">
    <div class="under-in" data-under-in><WorkIndex inert /></div>
  </div>
  <div class="sheet-wrap" data-sheet-wrap>
    <CaseSheet slug={slug} />
  </div>
</Base>
<script>
  ((window as unknown as { __afterPaint: (() => void)[] }).__afterPaint ??= []).push(() => {
    import('../../scripts/work').then((m) => m.start());
  });
</script>

<style>
  /* The index, fixed and dimmed behind the sheet. work.ts offsets it to where /work/ was scrolled. */
  .under { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; user-select: none; }
  .under-in { transform: translate3d(0, calc(var(--under-y, 0) * -1px), 0); }
  .under::after { content: ''; position: absolute; inset: 0; background: rgb(18 17 16 / .76); }
  .sheet-wrap { position: relative; z-index: 1; padding: 64px var(--edge) 0; }
  /* The site footer follows the sheet on a solid band, so it never prints over the dimmed index. */
  :global(body:has([data-sheet-wrap]) .foot) { position: relative; z-index: 1; margin-top: 0; background: var(--bg); }
  @media (max-width: 899px) {
    .sheet-wrap { padding: 44px 0 0; }
  }
</style>
