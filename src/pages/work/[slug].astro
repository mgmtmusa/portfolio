---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { cases, career, site, type Case } from '../../data/site';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Case };
const idx = cases.findIndex((x) => x.slug === c.slug);
const next = cases[(idx + 1) % cases.length];
const salesYears = career.slice(0, 3);
---

<Base
  title={`${c.title} — ${c.org} case study — ${site.name}`}
  description={`${c.summary} ${c.role}, ${c.when}.`}
  path={`/work/${c.slug}/`}
>
  <article class="case">
    <div class="case-top">
    <header class="case-head">
      <a class="back link" href="/#work">All work</a>
      <p class="meta">{c.org} case study</p>
      <h1 class="case-title">{c.title}</h1>
      <p class="case-summary">{c.summary}</p>
      <dl class="case-facts">
        <div><dt>Role</dt><dd>{c.role}</dd></div>
        <div><dt>When</dt><dd>{c.when}</dd></div>
        <div><dt>Where</dt><dd>{c.where}</dd></div>
      </dl>
    </header>
    <CaseCard c={c} variant="still" />
    </div>

    <section class="case-results" aria-labelledby="res-h">
      <h2 class="sr" id="res-h">Results</h2>
      <dl class="results results-lg">
        {
          c.results.map((r) => (
            <div>
              <dt>
                {r.l}
                {r.scope && <span class="scope">{r.scope}</span>}
              </dt>
              <dd>{r.v}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="case-body">
      <div class="case-main">
        <section aria-labelledby="brief-h">
          <h2 class="h4" id="brief-h">The brief</h2>
          <p>{c.brief}</p>
        </section>

        <section aria-labelledby="q-h">
          <h2 class="h4" id="q-h">The commercial question</h2>
          <p class="case-q">{c.question}</p>
        </section>

        <section aria-labelledby="resp-h">
          <h2 class="h4" id="resp-h">What I was responsible for</h2>
          <ul class="ticks">{c.responsibilities.map((r) => <li>{r}</li>)}</ul>
        </section>

        <section aria-labelledby="dec-h">
          <h2 class="h4" id="dec-h">Decisions I made</h2>
          <div class="decisions">
            {
              c.decisions.map((d) => (
                <div class="decision">
                  <h3 class="decision-t">{d.t}</h3>
                  <p>{d.d}</p>
                </div>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="ex-h">
          <h2 class="h4" id="ex-h">How it was carried out</h2>
          <ul class="ticks">{c.execution.map((r) => <li>{r}</li>)}</ul>
          {c.tools && <p class="case-tools">Tools: {c.tools.join(', ')}.</p>}
        </section>

        {
          c.slug === 'i-heart-uni' && (
            <section aria-labelledby="growth-h">
              <h2 class="h4" id="growth-h">Before and after</h2>
              <table class="bars">
                <caption class="sr">I Heart Uni growth, start of role compared with now</caption>
                <thead class="sr">
                  <tr><th scope="col">Measure</th><th scope="col">Start</th><th scope="col">Now</th></tr>
                </thead>
                <tbody>
                  <tr style="--a:400;--b:13200">
                    <th scope="row">Followers</th>
                    <td><span class="bar bar-a" />400</td>
                    <td><span class="bar bar-b" />13,200</td>
                  </tr>
                  <tr style="--a:280;--b:650">
                    <th scope="row">Average attendance</th>
                    <td><span class="bar bar-a" />280</td>
                    <td><span class="bar bar-b" />650</td>
                  </tr>
                </tbody>
              </table>
              <p class="bars-key"><span class="key key-a" /> When I started <span class="key key-b" /> Now</p>
            </section>
          )
        }

        {
          c.slug === 'evitech' && (
            <section aria-labelledby="sales-h">
              <h2 class="h4" id="sales-h">The sales years behind it</h2>
              <p>Before marketing, I spent almost two years in Evitech’s sales and business development roles.</p>
              <ol class="mini-rungs">
                {salesYears.map((r) => (
                  <li>
                    <span class="rung-when">{r.when}</span>
                    <b>{r.t}.</b> {r.d}
                  </li>
                ))}
              </ol>
              <p>I also flew to Sydney weekly to set up the NSW hub and negotiated its warehouse lease.</p>
            </section>
          )
        }

        <section aria-labelledby="evi-h">
          <h2 class="h4" id="evi-h">Evidence</h2>
          <p>
            {c.evidence.text}
            {c.evidence.href && (
              <>
                {' '}
                <a class="link" href={c.evidence.href} rel="noopener noreferrer" target="_blank">
                  {c.evidence.label}
                  <span class="sr"> (opens in a new tab)</span>
                </a>
              </>
            )}
          </p>
        </section>
      </div>
    </div>

    <nav class="case-next" aria-label="More case studies">
      <a class="next" href={`/work/${next.slug}/`}>
        <span class="meta">Next case study</span>
        <span class="next-t">{next.org}: {next.title}</span>
      </a>
      <a class="link" href="/#work">Back to all work</a>
    </nav>
  </article>
</Base>
