---
// CV: a plain, fast recruiter page. Every line comes from src/data/site.ts; the PDF is a direct download.
// Title and description: docs/v3/story.md §6. Scope notes travel with their figures (src/data/notes.ts).
import Base from '../layouts/Base.astro';
import Footnote from '../components/Footnote.astro';
import Notes from '../components/Notes.astro';
import { site, career, experience, cases, capabilities, tools, recognition, growthWork } from '../data/site';
import { notes } from '../data/notes';

// Footnotes in reading order.
type Note = { n: number; id: string; note: string };
const fn: Record<'spend' | 'pair' | 'hub' | 'closed' | 'events' | 'lil', Note> = {
  spend: { n: 1, id: 'fn-cv-spend', note: notes.spend },
  pair: { n: 2, id: 'fn-cv-pair', note: notes.evitechPair },
  hub: { n: 3, id: 'fn-cv-hub', note: notes.hub },
  closed: { n: 4, id: 'fn-cv-closed', note: notes.closed },
  events: { n: 5, id: 'fn-cv-events', note: notes.events },
  lil: { n: 6, id: 'fn-cv-lil', note: notes.lil },
};
const pageNotes = Object.values(fn);

const evitech = cases.find((c) => c.slug === 'evitech')!;
const ihu = cases.find((c) => c.slug === 'i-heart-uni')!;
const lil = cases.find((c) => c.slug === 'the-lil-project')!;
const paid = growthWork.find((g) => g.t === 'Paid acquisition')!;
const [cpa, leads] = paid.results;
const evitechYears = experience.find((e) => e.org === evitech.org)!.when;

// The four Evitech roles, most recent first. Each keeps its metric and that metric's note.
const roleNote: Record<string, Note> = {
  'Marketing & Growth Specialist': fn.spend,
  'Business Development & People Operations Manager': fn.hub,
  'B2B Sales Executive & Team Leader': fn.closed,
};
const roles = [...career].reverse().map((r, i) => ({ ...r, when: i === 0 ? evitech.when : r.when, note: roleNote[r.t] }));

// Everything outside Evitech, as listed in site.ts.
const others = experience
  .filter((e) => e.org !== evitech.org)
  .map((e) => ({ ...e, c: cases.find((c) => c.slug === e.case) }));
const lilResult = lil.results[0];
---

<Base
  title={`CV, ${site.name}, ${site.role}`}
  description={`The CV of ${site.name}, ${site.role} in ${site.city}: roles, results, tools and work rights, with the PDF as a direct download.`}
  path="/cv/"
>
  <div class="cv edge">
    <header class="cv-head">
      <h1 class="cv-name">{site.name}</h1>
      <p class="cv-role">{site.role}, {site.city}</p>
      <p class="cv-line">{site.line}</p>
      <div class="cv-acts">
        <a class="cta" href={site.cv} download data-track="cv_download" data-from="cv" data-cv-pdf>Download CV (PDF)</a>
        <a class="textlink" href={`mailto:${site.email}`}>{site.email}</a>
        <button class="textlink copy js-only" type="button" data-track="copy_email" data-from="cv">Copy email</button>
        <a class="textlink" href={site.linkedin} target="_blank" rel="noopener noreferrer" data-track="linkedin_click" data-from="cv">LinkedIn<span class="sr"> (opens in a new tab)</span></a>
      </div>
      <dl class="cv-facts">
        <div><dt class="label">Availability</dt><dd>{site.availability}</dd></div>
        <div><dt class="label">Work rights</dt><dd>{site.workRights}</dd></div>
        <div><dt class="label">Reply time</dt><dd>{site.replyTime.text}</dd></div>
      </dl>
    </header>

    <section class="sec" aria-labelledby="cv-exp-h">
      <h2 class="sec-h" id="cv-exp-h">Experience</h2>
      <ol class="sec-b orgs">
        <li class="org">
          <div class="org-head">
            <h3 class="org-t">{evitech.org}</h3>
            <p class="label">{evitechYears}</p>
          </div>
          <ol class="roles">
            {
              roles.map((r, i) => (
                <li class="role">
                  <h4 class="role-t">{r.t}</h4>
                  <p class="label role-when">{r.when}</p>
                  <p class="role-d">{r.d}{r.note && <Footnote {...r.note} />}</p>
                  {i === 0 && (
                    <p class="role-res" data-fact={`${cpa.v} ${leads.v}`}>
                      <b>{cpa.v}</b> {cpa.l} and <b>{leads.v}</b> {leads.l}. {paid.note}<Footnote {...fn.pair} />
                    </p>
                  )}
                  {r.link && <a class="textlink role-link" href={r.link.href} data-track="case_open" data-slug={evitech.slug} data-from="cv">{evitech.org} case study</a>}
                </li>
              ))
            }
          </ol>
        </li>
        {
          others.map((e) => (
            <li class="org">
              <div class="org-head">
                <h3 class="org-t">{e.org}</h3>
                <p class="label">{e.when}</p>
              </div>
              <div class="role">
                <h4 class="role-t">{e.role}</h4>
                {e.c ? <p class="role-d">{e.c.summary}</p> : e.note && <p class="role-d">{e.note}</p>}
                {e.c === ihu && (
                  <p class="role-res" data-fact={ihu.card.v}>
                    <b>{ihu.card.v}</b> {ihu.card.l}.<Footnote {...fn.events} />
                  </p>
                )}
                {e.c === lil && (
                  <p class="role-res" data-fact={lilResult.v}>
                    <b>{lilResult.v}</b> {lilResult.l} ({lilResult.scope}).<Footnote {...fn.lil} />
                  </p>
                )}
                {e.c && <a class="textlink role-link" href={`/work/${e.c.slug}/`} data-track="case_open" data-slug={e.c.slug} data-from="cv">{e.c.org} case study</a>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sec" aria-labelledby="cv-cap-h">
      <h2 class="sec-h" id="cv-cap-h">Capabilities</h2>
      <ul class="sec-b caps">
        {capabilities.map((c) => <li><h3 class="cap-t">{c.t}</h3><p class="cap-d">{c.items}.</p></li>)}
      </ul>
    </section>

    <section class="sec" aria-labelledby="cv-tools-h">
      <h2 class="sec-h" id="cv-tools-h">Tools</h2>
      <p class="sec-b tools">{tools.join(', ')}.</p>
    </section>

    <section class="sec" aria-labelledby="cv-rec-h">
      <h2 class="sec-h" id="cv-rec-h">Recognition</h2>
      <ul class="sec-b recs">
        {recognition.map((r) => <li><span class="rec-t">{r.t}, {r.when}.</span> {r.d}</li>)}
      </ul>
    </section>

    <section class="cv-notes" aria-label="Notes"><Notes notes={pageNotes} /></section>
  </div>
</Base>

<style>
  .cv { padding-top: clamp(112px, 16vh, 176px); }

  .cv-name { font: 540 clamp(52px, 7.4vw, 120px) / .9 var(--display); letter-spacing: -.045em; color: var(--ink-mast); text-wrap: balance; }
  .cv-role { margin-top: 20px; font: 500 15px / 1.3 var(--ui); color: var(--text-2); }
  .cv-line { margin-top: 28px; font: 480 clamp(24px, 2.2vw, 32px) / 1.16 var(--display); letter-spacing: -.02em; max-width: 26ch; text-wrap: balance; }
  .cv-acts { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 36px; }
  .cv-acts .textlink { display: inline-flex; min-height: 44px; align-items: center; }
  .copy { padding: 0; border: 0; background: none; cursor: pointer; }
  :global(html:not(.js)) .cv-acts .js-only { display: none; }
  .cv-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px var(--gutter); margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); }
  .cv-facts dd { margin: 8px 0 0; color: var(--text-2); font-size: 15px; line-height: 1.5; text-wrap: pretty; max-width: 40ch; }

  /* Sections: heading in the margin column, content on columns 4 to 12. */
  .sec { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); margin-top: 96px; padding-top: 28px; border-top: 1px solid var(--line); }
  .sec-h { grid-column: 1 / 4; font: 520 clamp(24px, 2vw, 30px) / 1.1 var(--display); letter-spacing: -.02em; }
  .sec-b { grid-column: 4 / 13; }

  .orgs { max-width: 820px; }
  .org + .org { margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--line); }
  .org-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 24px; }
  .org-t { font: 500 clamp(24px, 2vw, 28px) / 1.15 var(--display); letter-spacing: -.018em; }
  .roles { margin-top: 8px; }
  .role { display: grid; gap: 6px; padding-top: 20px; max-width: 72ch; }
  .roles .role + .role { margin-top: 8px; }
  .role-t { margin: 0; font: 500 17px / 1.35 var(--ui); }
  .role-when { margin-top: -2px; }
  .role-d, .role-res { font-size: 15px; line-height: 1.55; color: var(--text-2); text-wrap: pretty; }
  .role-res b { font-weight: 500; color: var(--text); }
  .role-link { justify-self: start; display: inline-flex; min-height: 44px; align-items: center; font-size: 14px; }

  .caps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px var(--gutter); }
  .cap-t { font: 500 17px / 1.35 var(--ui); }
  .cap-d { margin-top: 6px; font-size: 15px; line-height: 1.55; color: var(--text-2); max-width: 44ch; }
  .tools { color: var(--text-2); max-width: 70ch; text-wrap: pretty; }
  .recs li { padding: 12px 0; color: var(--text-2); max-width: 75ch; }
  .recs li:first-child { padding-top: 0; }
  .recs li + li { border-top: 1px solid var(--line); }
  .rec-t { color: var(--text); font-weight: 500; }

  .cv-notes { margin-top: 96px; }

  @media (max-width: 639px) {
    .cv { padding-top: 112px; }
    .cv-acts { gap: 4px 28px; }
    .cv-acts .cta { margin-bottom: 8px; }
  }
  @media (max-width: 899px) {
    .sec-h, .sec-b { grid-column: 1 / -1; }
    .sec { row-gap: 20px; margin-top: 72px; }
    .cv-facts { grid-template-columns: 1fr; gap: 20px; }
    .caps { grid-template-columns: 1fr; }
  }

  /* Recruiters print CVs: dark ink on white paper, without the chrome. */
  @media print {
    :global(.strip), :global([data-dock]), :global(.toasts), :global(.foot), :global(.skip), :global(.fn-pop), .cv-acts .cta, .cv-acts .copy { display: none !important; }
    :global(html), :global(body) { background: #fff !important; }
    :global(body::before) { display: none !important; }
    .cv, .cv * { color: #111 !important; border-color: #ccc !important; }
    .cv { padding-top: 0; }
    .sec { break-inside: auto; margin-top: 32px; }
    .org { break-inside: avoid; }
  }
</style>
