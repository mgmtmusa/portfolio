---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Path for the canonical URL, e.g. "/" or "/work/evitech/" */
  path: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description = site.description, path, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
const isHome = path === '/';
const homeHref = (hash: string) => (isHome ? hash : `/${hash}`);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ede8de" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Musa Abdullah Walid — Marketing & Growth Specialist, Melbourne" />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="top-name" href={isHome ? '#top' : '/'}>{site.name}</a>
      <nav class="top-nav" aria-label="Main">
        <a href={homeHref('#work')}>Work</a>
        <a class="hide-sm" href={homeHref('#approach')}>Approach</a>
        <a class="hide-sm" href={homeHref('#career')}>Career</a>
        <a class="hide-sm" href={homeHref('#experience')}>Experience</a>
        <a class="top-contact" href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="contact" id="contact">
      <div class="contact-in">
        <h2 class="contact-h">Hiring for marketing or growth?</h2>
        <p class="contact-p">
          Email is the fastest way to reach me. I’m based in Melbourne with full Australian working rights.
        </p>
        <div class="contact-actions">
          <a class="btn btn-ink" href={`mailto:${site.email}`}>Email {site.email}</a>
          <a class="btn btn-line" href={site.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn profile<span class="sr"> (opens in a new tab)</span></a>
        </div>
        <p class="contact-foot">© {new Date().getFullYear()} {site.name}</p>
      </div>
    </footer>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
