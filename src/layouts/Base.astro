---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import StatusStrip from '../components/StatusStrip.astro';
import Dock from '../components/Dock.astro';
import CommandMenu from '../components/CommandMenu.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Path for the canonical URL, e.g. "/" or "/work/evitech/" */
  path: string;
  /** Share image path under /og/ (1200×630). */
  og?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogAlt?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Canonical override (company links point to /). */
  canonicalPath?: string;
}
const {
  title,
  description = site.description,
  path,
  og = '/og/home.png',
  ogTitle = title,
  ogDescription = description,
  ogAlt = `${site.name}, ${site.role}, ${site.city}`,
  jsonLd,
  noindex = false,
  canonicalPath,
} = Astro.props;
const canonical = new URL(canonicalPath ?? path, site.url).href;
const ogImage = new URL(og, site.url).href;
const year = new Date().getFullYear();
// Vercel Web Analytics exists only on Vercel; locally its script would 404 and log a console error.
const analytics = Boolean(import.meta.env.VERCEL);
---

<!doctype html>
<html lang="en-AU" data-analytics={analytics ? 'on' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#121110" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/host-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try { if (localStorage.getItem('motion') === 'reduce') root.dataset.motion = 'reduce'; } catch (e) {}
        // Astro's view-transition swap replaces every attribute on <html>; carry the client state across.
        document.addEventListener('astro:before-swap', function (e) {
          var next = e.newDocument.documentElement;
          root.classList.forEach(function (c) { next.classList.add(c); });
          if (root.dataset.motion) next.dataset.motion = root.dataset.motion;
        });
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <StatusStrip />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="foot wrap">
      <p class="foot-name">{site.name}</p>
      <ul class="foot-links">
        <li><a href="/work/">Work</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/cv/">CV</a></li>
        <li><a href={site.cv} download data-track="cv_download" data-from="footer">Download CV<span class="sr"> (PDF)</span></a></li>
        <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer" data-track="linkedin_click" data-from="footer">LinkedIn<span class="sr"> (opens in a new tab)</span></a></li>
      </ul>
      <p class="foot-c label">© {year} {site.name}</p>
    </footer>
    <Dock />
    <CommandMenu />
    <div class="toasts" data-toasts aria-live="polite" transition:persist="toasts"></div>
    {analytics && <Analytics />}
    <script>
      import '../scripts/chrome';
    </script>
  </body>
</html>

<style>
  .foot {
    display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 16px 24px;
    padding-top: 96px; padding-bottom: 120px; border-top: 1px solid var(--line); margin-top: 120px;
  }
  .foot-name { font: 540 clamp(40px, 6vw, 88px) / .9 var(--display); letter-spacing: -.04em; color: var(--ink-mast); grid-column: 1 / -1; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 4px 24px; font: 500 15px / 1 var(--ui); }
  .foot-links a { display: inline-flex; min-height: 44px; align-items: center; color: var(--text-2); text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { .foot-links a:hover { color: var(--text); } }
  .foot-c { justify-self: end; }
  @media (max-width: 639px) { .foot { grid-template-columns: 1fr; padding-bottom: 112px; } .foot-c { justify-self: start; } }

  .toasts { position: fixed; z-index: 60; left: 50%; bottom: 96px; transform: translateX(-50%); display: grid; gap: 8px; pointer-events: none; }
  :global(.toast) {
    --rim: .35; margin: 0; padding: 12px 18px; border-radius: 16px; font: 500 14px / 1.3 var(--ui); color: var(--text);
    animation: toast-in var(--dur-ui) var(--ease-out);
    transition: opacity var(--dur-ui) ease-out, transform var(--dur-ui) ease-out;
  }
  :global(.toast-out) { opacity: 0; transform: translateY(6px); }
  @keyframes toast-in { from { opacity: 0; transform: translateY(8px) scale(.98); } }
</style>
